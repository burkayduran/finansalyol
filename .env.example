# Expo istemcisi bu değişkenleri okur (EXPO_PUBLIC_ ile başlamalı).
# Supabase projeni oluştur: https://supabase.com -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Analytics (opsiyonel) — PostHog EU host (KVKK: veri AB'de kalır).
# Boşsa analytics yalnız dev console'a yazar; prod'da sessiz.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Hata izleme (opsiyonel) — Sentry DSN. Boşsa sessiz.
EXPO_PUBLIC_SENTRY_DSN=

# E-posta hatırlatma yayında mı? (Resend domain doğrulanınca "true")
EXPO_PUBLIC_EMAIL_ENABLED=false

# --- Sadece Edge Function (reminder-cron) için, istemciye GİTMEZ ---
# supabase secrets set ... ile ayarlanır:
# RESEND_API_KEY=...
# RESEND_FROM="Borç Takip <hatirlatma@alanadın.app>"
