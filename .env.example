# Expo istemcisi bu değişkenleri okur (EXPO_PUBLIC_ ile başlamalı).
# Supabase projeni oluştur: https://supabase.com -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

